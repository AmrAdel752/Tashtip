    <style>
        .whatsapp-float {
            position: fixed;
            inset-inline-start: 20px;
            bottom: 20px;
            width: 56px;
            height: 56px;
            border-radius: 50%;
            background: #25d366;
            color: #fff;
            font-size: 28px;
            box-shadow: 0 4px 14px rgba(0,0,0,.25);
            z-index: 1030;
            transition: transform .15s ease;
        }

        .whatsapp-float:hover {
            color: #fff;
            transform: scale(1.08);
        }
    </style>



