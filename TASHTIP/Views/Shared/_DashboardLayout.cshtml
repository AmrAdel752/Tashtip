@using TASHTIP.EF.Entities.Employee
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@{
    var isAdmin = await AuthorizationServices.AuthorizeAsync(User, "Permissions.Admin");
    var currentUser = SignInManager.IsSignedIn(User) ? await UserManager.GetUserAsync(User) : null;
    string CurrentController = (string)ViewContext.RouteData.Values["controller"]!;
    string CurrentAction = (string)ViewContext.RouteData.Values["action"]!;
    bool IsActive(string controller, string action = "") =>
        string.Equals(CurrentController, controller, StringComparison.OrdinalIgnoreCase) &&
        (string.IsNullOrEmpty(action) || string.Equals(CurrentAction, action, StringComparison.OrdinalIgnoreCase));
}
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>@ViewData["Title"] - Tashtip</title>
    <partial name="_Style" />
    <link href="~/LayoutTASHTIP/CSS/dashboard.css" rel="stylesheet" />
</head>
<body class="dash-body">
    <div class="dash-wrapper">
        <aside class="dash-sidebar" id="dashSidebar">
            <div class="brand">
                <img src="~/LayoutTASHTIP/Images/ico.ico" alt="Tashtip" />
                <span>Tashtip @(isAdmin.Succeeded ? "Admin" : "Account")</span>
            </div>

            @if (isAdmin.Succeeded)
            {
                <div class="nav-section-title">لوحة التحكم</div>
                <a class="nav-link @(IsActive("Admin","Dashboard") ? "active" : "")" asp-controller="Admin" asp-action="Dashboard">
                    <i class="bi bi-speedometer2"></i> نظرة عامة
                </a>
                <div class="nav-section-title">إدارة الطلبات</div>
                <a class="nav-link @(IsActive("Admin","Requests") ? "active" : "")" asp-controller="Admin" asp-action="Requests">
                    <i class="bi bi-card-checklist"></i> طلبات الحجز
                </a>
                <a class="nav-link @(IsActive("Admin","Appointments") ? "active" : "")" asp-controller="Admin" asp-action="Appointments">
                    <i class="bi bi-calendar2-check"></i> مواعيد المعاينة
                </a>
                <div class="nav-section-title">المحتوى</div>
                <a class="nav-link @(IsActive("Admin","Gallery") ? "active" : "")" asp-controller="Admin" asp-action="Gallery">
                    <i class="bi bi-images"></i> معرض الوحدات
                </a>
                <a class="nav-link @(IsActive("Home","AddProject") ? "active" : "")" asp-controller="Home" asp-action="AddProject">
                    <i class="bi bi-plus-square"></i> إضافة مشروع
                </a>
                <a class="nav-link @(IsActive("Admin","Reviews") ? "active" : "")" asp-controller="Admin" asp-action="Reviews">
                    <i class="bi bi-star"></i> تقييمات العملاء
                </a>
                <div class="nav-section-title">النظام</div>
                <a class="nav-link @(IsActive("Admin","Users") ? "active" : "")" asp-controller="Admin" asp-action="Users">
                    <i class="bi bi-people"></i> المستخدمون والصلاحيات
                </a>
            }
            else
            {
                <div class="nav-section-title">حسابي</div>
                <a class="nav-link @(IsActive("Account","MyRequests") ? "active" : "")" asp-controller="Account" asp-action="MyRequests">
                    <i class="bi bi-card-checklist"></i> طلباتي
                </a>
                <a class="nav-link @(IsActive("Account","MyAppointments") ? "active" : "")" asp-controller="Account" asp-action="MyAppointments">
                    <i class="bi bi-calendar2-check"></i> مواعيدي
                </a>
                <a class="nav-link @(IsActive("Account","BookAppointment") ? "active" : "")" asp-controller="Account" asp-action="BookAppointment">
                    <i class="bi bi-calendar-plus"></i> احجز معاينة
                </a>
                <a class="nav-link @(IsActive("Account","EstimateCost") ? "active" : "")" asp-controller="Account" asp-action="EstimateCost">
                    <i class="bi bi-calculator"></i> حاسبة التكلفة
                </a>
            }

            <div class="nav-section-title">&nbsp;</div>
            <a class="nav-link" asp-controller="Home" asp-action="Home">
                <i class="bi bi-house"></i> رجوع للموقع
            </a>
            <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Home","Home")" method="post">
                <button type="submit" class="nav-link border-0 bg-transparent w-100 text-start">
                    <i class="bi bi-box-arrow-right"></i> تسجيل الخروج
                </button>
            </form>
        </aside>

        <div class="dash-main">
            <header class="dash-topbar">
                <div class="d-flex align-items-center gap-3">
                    <button class="btn btn-sm btn-light d-lg-none" id="dashSidebarToggle" type="button">
                        <i class="bi bi-list"></i>
                    </button>
                    <h1 class="page-title h5">@ViewData["Title"]</h1>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <span class="text-muted small d-none d-sm-inline">
                        <i class="bi bi-person-circle"></i> @currentUser?.UserName
                    </span>
                </div>
            </header>

            <partial name="_NotificationMessage" />

            <main class="dash-content">
                @RenderBody()
            </main>
        </div>
    </div>

    <partial name="_Scripts" />
    <script src="~/LayoutTASHTIP/Vendors/chart.js/chart.umd.js"></script>
    <script>
        document.getElementById('dashSidebarToggle')?.addEventListener('click', function () {
            document.getElementById('dashSidebar').classList.toggle('show');
        });

        // Shared small toast helper for the admin/customer AJAX actions (built on the
        // SweetAlert2 vendor already loaded site-wide, so no extra dependency needed).
        function dashToast(icon, message) {
            Swal.fire({
                toast: true,
                position: 'top-start',
                icon: icon,
                title: message,
                showConfirmButton: false,
                timer: 2200,
                timerProgressBar: true
            });
        }
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
