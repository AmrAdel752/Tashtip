@model List<TASHTIP.EF.Entities.Production.Review>
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "تقييمات بانتظار المراجعة";
}

<div class="dash-card">
    @if (!Model.Any())
    {
        <p class="text-muted mb-0">لا توجد تقييمات بانتظار المراجعة حالياً.</p>
    }
    else
    {
        <div class="row g-3" id="reviewsGrid">
            @foreach (var r in Model)
            {
                <div class="col-md-6 col-lg-4" data-review-id="@r.ID">
                    <div class="border rounded p-3 h-100 d-flex flex-column">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <strong>@r.CustomerName</strong>
                            <span class="text-warning">@string.Concat(Enumerable.Repeat("★", r.Rating))@string.Concat(Enumerable.Repeat("☆", 5 - r.Rating))</span>
                        </div>
                        <p class="flex-grow-1">@r.Comment</p>
                        <div class="small text-muted mb-2">@r.CreatedAt.ToString("yyyy-MM-dd")</div>
                        <div class="d-flex gap-2">
                            <button class="btn btn-sm btn-tashtip flex-grow-1 btn-approve" data-id="@r.ID">قبول</button>
                            <button class="btn btn-sm btn-outline-danger flex-grow-1 btn-reject" data-id="@r.ID">رفض</button>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@section Scripts {
    <script>
        $('.btn-approve').on('click', function () {
            var card = $(this).closest('[data-review-id]');
            $.post('@Url.Action("ApproveReview")', { id: card.data('review-id') }, function () {
                card.fadeOut(200, function () { $(this).remove(); });
            });
        });
        $('.btn-reject').on('click', function () {
            var card = $(this).closest('[data-review-id]');
            $.post('@Url.Action("RejectReview")', { id: card.data('review-id') }, function () {
                card.fadeOut(200, function () { $(this).remove(); });
            });
        });
    </script>
}
