@page
@model LoginModel
@{
    ViewData["Title"] = "تسجيل الدخول";
}
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Tashtip</title>
    <link href="~/LayoutTASHTIP/Images/ico.ico" rel="icon" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800&display=swap" rel="stylesheet" />
    <link href="~/LayoutTASHTIP/Vendors/bootstrap/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/LayoutTASHTIP/CSS/bootstrap.rtl.min.css" rel="stylesheet" />
    <link href="~/LayoutTASHTIP/Vendors/bootstrap-icons/bootstrap-icons.css" rel="stylesheet" />
    <link href="~/LayoutTASHTIP/CSS/auth.css" rel="stylesheet" />
</head>
<body>
    <div class="auth-wrapper">
        <div class="auth-brand">
            <div class="auth-brand-inner">
                <img src="~/LayoutTASHTIP/Images/ico.ico" alt="Tashtip" class="auth-logo" />
                <h1>Tashtip <span>تشطيب</span></h1>
                <img src="~/LayoutTASHTIP/style_login_register/signin-image.jpg" alt="" class="auth-illustration" />
                <p>شريكك الموثوق في تشطيب وتجهيز شقتك بأعلى جودة - تابع طلباتك ومواعيدك من مكان واحد.</p>
            </div>
        </div>

        <div class="auth-form-panel">
            <div class="auth-card">
                <h2 class="auth-title">تسجيل الدخول</h2>
                <p class="auth-subtitle">أدخل بياناتك للوصول لحسابك</p>

                <div asp-validation-summary="All" class="auth-validation-summary"></div>

                <form method="post">
                    <div class="mb-3">
                        <label asp-for="Input.UserName" class="form-label">اسم المستخدم</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-person"></i></span>
                            <input asp-for="Input.UserName" class="form-control" placeholder="اسم المستخدم" autocomplete="username" />
                        </div>
                        <span asp-validation-for="Input.UserName" class="text-danger small"></span>
                    </div>

                    <div class="mb-2">
                        <label asp-for="Input.Password" class="form-label">كلمة المرور</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-lock"></i></span>
                            <input asp-for="Input.Password" class="form-control" placeholder="كلمة المرور" autocomplete="current-password" />
                        </div>
                        <span asp-validation-for="Input.Password" class="text-danger small"></span>
                    </div>

                    <div class="form-check mb-3">
                        <input asp-for="Input.RememberMe" class="form-check-input" />
                        <label asp-for="Input.RememberMe" class="form-check-label">تذكرني</label>
                    </div>

                    <button type="submit" class="btn btn-tashtip w-100">دخول</button>

                    <p class="text-center small mt-3 mb-0">
                        ليس لديك حساب؟ <a asp-area="Identity" asp-page="/Account/Register">إنشاء حساب جديد</a>
                    </p>
                    <p class="text-center small mt-2 mb-0">
                        <a asp-controller="Home" asp-action="Home">رجوع للموقع</a>
                    </p>
                </form>
            </div>
        </div>
    </div>

    <script src="~/LayoutTASHTIP/Vendors/jquery/jquery.js"></script>
    <script src="~/LayoutTASHTIP/Vendors/bootstrap/js/bootstrap.bundle.min.js"></script>
    <partial name="_ValidationScriptsPartial" />
</body>
</html>
